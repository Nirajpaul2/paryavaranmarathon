# Marathon Registration Isolated Environment Variables
# Dedicated database - isolated SQLite file or dedicated PostgreSQL URL
DATABASE_URL="file:./marathon.db"
# MARATHON_DATABASE_URL="postgresql://user:password@localhost:5439/marathon_db?schema=public"

# Admin Authentication Secret for JWT session cookies
MARATHON_AUTH_SECRET="replace-with-a-secure-random-secret-key-marathon-2026"

# Port & URL
PORT=3010
MARATHON_PUBLIC_URL="http://localhost:3010"

# Storage for private payment proof uploads
MARATHON_STORAGE_DIR="./uploads"
