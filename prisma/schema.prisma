generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model EventSetting {
  id                   String   @id @default("default")
  eventName            String   @default("पर्यावरण मैराथन (Paryavaran Marathon 2026)")
  eventTagline         String   @default("हर कदम प्रकृति के नाम • Fit For a Greener Tomorrow")
  eventDate            String   @default("27 सितंबर 2026 (रविवार)")
  eventTime            String   @default("06:00 AM IST")
  reportingTime        String   @default("05:15 AM IST")
  venue                String   @default("राजकीय उत्क्रमित मध्य विद्यालय मालती पूर्वी")
  distance             String   @default("5 KM")
  registrationFee      Int      @default(99)
  registrationDeadline DateTime @default("2026-09-26T23:59:59.000Z")
  participantCapacity  Int      @default(2000)
  contactEmail         String   @default("support@paryavaranmarathon.org")
  contactPhone         String   @default("8340477782")
  organizerName        String   @default("संस्थापक: नीरज स्टार")
  phonePeQrPath        String   @default("/images/phonepe-qr.svg")
  phonePeUpiId         String   @default("7367050371@ybl")
  bibPrefix            String   @default("BIB-")
  regPrefix            String   @default("RUN5K-")
  updatedAt            DateTime @updatedAt
}

model Participant {
  id              String        @id @default(cuid())
  fullName        String
  mobile          String        @unique
  email           String        @unique
  dob             String
  gender          String
  city            String
  state           String
  emergencyName   String
  emergencyMobile String
  tshirtSize      String?
  bloodGroup      String?
  runningExp      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  registration    Registration?
}

model Registration {
  id                 String            @id @default(cuid())
  registrationNumber String?           @unique
  bibNumber          String?           @unique
  participantId      String            @unique
  participant        Participant       @relation(fields: [participantId], references: [id], onDelete: Cascade)
  status             String            @default("PENDING") // PENDING, CONFIRMED, REJECTED, CANCELLED
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  payment            Payment?
  auditLogs          PaymentAuditLog[]
}

model Payment {
  id              String       @id @default(cuid())
  registrationId  String       @unique
  registration    Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  amount          Int
  transactionId   String?      @unique
  proofPath       String?
  proofFileName   String?
  status          String       @default("PENDING") // PENDING, VERIFIED, REJECTED
  rejectionReason String?
  verifiedAt      DateTime?
  verifiedBy      String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("SUPERADMIN")
  createdAt    DateTime @default(now())
}

model PaymentAuditLog {
  id                String       @id @default(cuid())
  registrationId    String
  registration      Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  adminEmail        String
  action            String
  oldPaymentStatus  String?
  newPaymentStatus  String?
  oldRegStatus      String?
  newRegStatus      String?
  notes             String?
  timestamp         DateTime     @default(now())
}
